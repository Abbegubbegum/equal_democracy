{
  "name": "equal_democracy",
  "version": "1.3.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:web:live": "pnpm --filter web dev:live",
    "dev:mobile:live": "pnpm --filter mobile dev:live",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,md,json,yml,yaml,css}": "prettier --write"
  }
}
