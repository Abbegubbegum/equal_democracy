{
  "$schema": "https://v2-10-11.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ANTHROPIC_API_KEY",
        "RESEND_API_KEY",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "PUSHER_CLUSTER",
        "PUSHER_APP_ID",
        "PUSHER_KEY",
        "PUSHER_SECRET",
        "MONGODB_URI",
        "NODE_ENV",
        "BLOB_STORE_ID",
        "BLOB_WEBHOOK_PUBLIC_KEY",
        "BLOB_READ_WRITE_TOKEN",
        "CRON_SECRET",
        "SWISH_ENV",
        "SWISH_PAYEE_ALIAS",
        "SWISH_CALLBACK_BASE_URL",
        "SWISH_CERT_BASE64",
        "SWISH_KEY_BASE64",
        "MEMBERSHIP_FEE_SEK",
        "MOBILE_LATEST_VERSION",
        "MOBILE_MIN_SUPPORTED_VERSION",
        "ENABLE_EXPERIMENTAL_COREPACK",
        "GRANDID_ENV",
        "GRANDID_API_KEY",
        "GRANDID_SIGN_SERVICE_KEY",
        "GRANDID_AUTH_SERVICE_KEY",
        "VOTE_ID_PEPPER",
        "LOGIN_ID_PEPPER"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "ios": {
      "cache": false,
      "persistent": true
    }
  }
}
